# GEMINI_API_KEY: Khóa API cho trợ lý AI và cố vấn kỹ thuật thông minh.
# Lấy khóa API tại Google AI Developer Portal hoặc cấu hình trong môi trường Cloud Server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Domain URL chính thức của hệ thống (ví dụ: https://solutionbao.vn)
# Sử dụng cho SEO Canonical, Sitemap, OpenGraph metadata và API endpoints.
APP_URL="https://solutionbao.vn"
